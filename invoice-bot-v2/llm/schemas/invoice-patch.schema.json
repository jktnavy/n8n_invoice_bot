{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://statransport.local/schemas/invoice-patch.v1.json",
  "title": "InvoicePatchExtractionV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "patches", "missing_fields"],
  "properties": {
    "schema_version": { "const": "invoice-patch.v1" },
    "patches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "field", "value"],
        "properties": {
          "target": {
            "type": "string",
            "enum": ["draft", "item:return_trip"],
            "description": "draft or semantic item reference"
          },
          "field": {
            "type": "string",
            "enum": ["trip_date", "unit_price", "payment_type", "down_payment_amount"]
          },
          "value": {}
        }
      }
    },
    "missing_fields": { "type": "array", "items": { "type": "string" } }
  }
}
