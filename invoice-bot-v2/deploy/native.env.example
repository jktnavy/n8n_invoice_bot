# Copy to /opt/invoice-bot-v2/.env on the target server.
# Fill secrets on the server only. Do not commit real values.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=invoice_bot_v2
MYSQL_USER=invoice_bot_v2
MYSQL_PASSWORD=

N8N_HOST=127.0.0.1
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_ENCRYPTION_KEY=
NODE_FUNCTION_ALLOW_BUILTIN=crypto
WEBHOOK_URL=

TELEGRAM_BOT_TOKEN=

LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

INVOICE_RENDERER_URL=http://127.0.0.1:8000
INVOICE_RENDERER_HOST=127.0.0.1
INVOICE_RENDERER_PORT=8000
INVOICE_OUTPUT_DIR=/var/lib/invoice-bot-v2/invoices
